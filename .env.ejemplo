# === Configuración de la base de datos PostgreSQL ===
# 1) Copiá este archivo y renombralo a  .env  (sin nada delante del punto).
# 2) Poné tu contraseña de PostgreSQL en PG_PASSWORD.
# 3) Guardá. La app y el importador lo leen automáticamente.
#
# Esta contraseña queda SOLO en tu PC, en este archivo.

PG_DB=alquileres
PG_USER=postgres
PG_PASSWORD=PONE_TU_CONTRASEÑA_ACA
PG_HOST=localhost
PG_PORT=5432

# Clave interna de la app (podés dejar esta o cambiarla por cualquier texto largo).
SECRET_KEY=cambia-esto-por-un-texto-largo-y-secreto

# --- Alternativa avanzada: en vez de las 5 variables de arriba, podés usar
# --- una sola URL completa (si la usás, tiene prioridad):
# DATABASE_URL=postgresql+psycopg2://postgres:clave@localhost:5432/alquileres

# === Integración con el Facturador ARCA (opcional) ===
# Al generar una liquidación, la inmobiliaria emite la factura de honorarios
# (comisión) al propietario a través del servicio Facturador ARCA.
# Dejar FACTURADOR_URL vacío desactiva la integración.
FACTURADOR_URL=http://localhost:8000
# Restringe el facturador a UNA inmobiliaria (solo la de este CUIT). Vacío = sin restricción.
FACTURADOR_CUIT=
FACTURADOR_TIMEOUT=20
# Concepto que aparece en la factura de honorarios:
FACTURA_CONCEPTO=HONORARIOS PROFESIONALES
